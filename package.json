{
  "name": "echoes-below",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "node scripts/generate-campaign-map.mjs && vite build && node scripts/build-worker.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/backend*.test.ts",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "typecheck:hosted": "tsc -p tsconfig.hosted.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
